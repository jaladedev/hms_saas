# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_ and never import in client components.
SUPABASE_SERVICE_ROLE_KEY=
# Signs guest booking links (lib/booking-token.ts). At least 32 random characters, for example `openssl rand -base64 48`.
BOOKING_TOKEN_SECRET=

# Paystack secret keys are NOT stored in the database. payment_provider_accounts.secret_reference points at an
# environment variable using the form `env:NAME`, so add one variable per hotel account, for example:
# PAYSTACK_SECRET_HOTEL_A=
# The webhook URL for each account is https://<your-domain>/api/webhooks/paystack/<payment_provider_accounts.id>

# The PLATFORM's own Paystack secret key, used only for hotels paying their platform invoices online (migration 117). Leave unset to
# keep invoices paid by hand: the "Pay online" button then does not appear. Set the platform Paystack account's webhook to
# https://<your-domain>/api/webhooks/platform-paystack
# PLATFORM_PAYSTACK_SECRET_KEY=

# Guest emails (lib/email). Without RESEND_API_KEY and EMAIL_FROM, mail stays in the outbox (nothing is lost or marked sent).
# EMAIL_FROM must be an address on a domain verified in Resend, e.g. "Hotel A <bookings@hotel-a.example>".
RESEND_API_KEY=
EMAIL_FROM=
# Development only: EMAIL_TRANSPORT=log prints a masked recipient and subject instead of sending. EMAIL_LINK_SCHEME=http for local links.
# EMAIL_TRANSPORT=log
# EMAIL_LINK_SCHEME=http

# Guest text messages (lib/sms, migration 147). Without TERMII_API_KEY and TERMII_SENDER_ID, texts stay in the outbox (nothing is lost
# or marked sent). TERMII_SENDER_ID must be a sender name registered with Termii for Nigeria. TERMII_BASE_URL is the address shown on
# your Termii dashboard (default https://api.ng.termii.com). TERMII_WHATSAPP_FROM is the WhatsApp device or sender name, only needed
# for a hotel that picks WhatsApp. Development only: SMS_TRANSPORT=log prints a masked number and the length instead of sending.
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_WHATSAPP_FROM=
# SMS_TRANSPORT=log

# Authorises the scheduler that calls /api/cron/maintenance (hold expiry, email backstop, cleanup). At least 32 random characters.
CRON_SECRET=

# AI reply drafts on /app/messages (TODO 8.14). Optional: without a key the button says drafts are not set up. Also needs the hotel group's
# `ai_helpers` entitlement switched on by the platform. Only the hotel name, the guest's first name and the message text are sent.
# ANTHROPIC_API_KEY=
# AI_DRAFT_MODEL=claude-haiku-5-5
