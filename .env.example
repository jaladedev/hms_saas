# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_ and never import in client components.
SUPABASE_SERVICE_ROLE_KEY=
# Signs guest booking links (lib/booking-token.ts). At least 32 random characters, for example `openssl rand -base64 48`.
BOOKING_TOKEN_SECRET=

# Paystack secret keys are NOT stored in the database. payment_provider_accounts.secret_reference points at an
# environment variable using the form `env:NAME`, so add one variable per hotel account, for example:
# PAYSTACK_SECRET_HOTEL_A=
# The webhook URL for each account is https://<your-domain>/api/webhooks/paystack/<payment_provider_accounts.id>

# Guest emails (lib/email). Without RESEND_API_KEY and EMAIL_FROM, mail stays in the outbox (nothing is lost or marked sent).
# EMAIL_FROM must be an address on a domain verified in Resend, e.g. "Hotel A <bookings@hotel-a.example>".
RESEND_API_KEY=
EMAIL_FROM=
# Development only: EMAIL_TRANSPORT=log prints a masked recipient and subject instead of sending. EMAIL_LINK_SCHEME=http for local links.
# EMAIL_TRANSPORT=log
# EMAIL_LINK_SCHEME=http

# Authorises the scheduler that calls /api/cron/maintenance (hold expiry, email backstop, cleanup). At least 32 random characters.
CRON_SECRET=
